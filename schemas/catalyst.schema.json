{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutuo.example/superreforge/catalyst.schema.json",
  "title": "Super Reforge 重铸媒介定义",
  "type": "object",
  "additionalProperties": false,
  "required": ["ingredient", "count", "levels"],
  "properties": {
    "ingredient": {"$ref": "#/$defs/selector"},
    "count": {"type": "integer", "minimum": 1},
    "experience": {"type": "integer", "minimum": 0, "default": 0},
    "allow_same_modifier": {"type": "boolean", "default": false},
    "allowed_item_types": {"type": "array", "items": {"$ref": "#/$defs/resourceLocation"}, "default": []},
    "denied_item_types": {"type": "array", "items": {"$ref": "#/$defs/resourceLocation"}, "default": []},
    "levels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["level", "weight"],
        "properties": {
          "level": {"$ref": "#/$defs/resourceLocation"},
          "weight": {"type": "number", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "resourceLocation": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
    "selector": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "item": {"$ref": "#/$defs/resourceLocation"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/resourceLocation"}},
        "tag": {"$ref": "#/$defs/resourceLocation"},
        "curios": {"const": "any"},
        "kubejs_predicate": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["item"]}, {"required": ["items"]}, {"required": ["tag"]},
        {"required": ["curios"]}, {"required": ["kubejs_predicate"]}
      ]
    }
  }
}
